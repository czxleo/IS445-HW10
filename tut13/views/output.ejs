<%- include("_header") -%>
<h1>Export products</h1>
<p>Click Download to export all database records to export.csv.</p>

<form action="/output" method="post">
  <button class="btn btn-primary" type="submit">Download CSV</button>
</form>

<% if (message && message.substring(0, 5) === "Error") { %>
  <h2 class="mt-3">Error</h2>
  <p class="text-danger"><%= message %></p>
<% } %>

<%- include("_footer") -%>
